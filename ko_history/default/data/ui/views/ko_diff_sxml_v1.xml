<dashboard version="1.1" theme="dark">
  <label>Network Health (Test v1)</label>
  <description>Test fixture v1 for the Dashboard Diff viz (Simple XML).</description>
  <row>
    <panel>
      <title>Clients by Access Point</title>
      <chart>
        <search>
          <query>index=_internal | stats count by sourcetype | head 5</query>
          <earliest>-1h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
    <panel>
      <title>Latency</title>
      <single>
        <search>
          <query>index=_internal | stats count</query>
          <earliest>-1h</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Signal Quality - SNR</title>
      <chart>
        <search>
          <query>index=_internal | timechart count</query>
          <earliest>-1h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
    <panel>
      <title>Errors</title>
      <table>
        <search>
          <query>index=_internal log_level=ERROR | table _time component</query>
          <earliest>-1h</earliest>
          <latest>now</latest>
        </search>
      </table>
    </panel>
  </row>
</dashboard>
