<dashboard version="1.1" theme="dark">
  <label>Network Health (Test v2)</label>
  <description>Test fixture v2 for the Dashboard Diff viz (Simple XML). vs v1: Latency retitled+researched, SNR research changed, Throughput added.</description>
  <row>
    <panel>
      <title>Clients by Access Point</title>
      <chart>
        <search>
          <query>index=_internal | stats count by sourcetype | head 5</query>
          <earliest>-1h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
    <panel>
      <title>Latency (p95)</title>
      <single>
        <search>
          <query>index=_internal | stats p95(linecount) as p95</query>
          <earliest>-1h</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Signal Quality - SNR</title>
      <chart>
        <search>
          <query>index=_internal | timechart avg(linecount) as snr</query>
          <earliest>-1h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
    <panel>
      <title>Errors</title>
      <table>
        <search>
          <query>index=_internal log_level=ERROR | table _time component</query>
          <earliest>-1h</earliest>
          <latest>now</latest>
        </search>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Throughput</title>
      <chart>
        <search>
          <query>index=_internal | timechart sum(linecount) as throughput</query>
          <earliest>-1h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">area</option>
      </chart>
    </panel>
  </row>
</dashboard>
